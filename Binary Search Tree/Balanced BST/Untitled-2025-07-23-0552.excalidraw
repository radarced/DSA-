    {
      "id": "yGxLq16OSFEa232cy6FA4",
      "type": "text",
      "x": -1463.255797597096,
      "y": -3585.942855131121,
      "width": 536.3195190429688,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7b",
      "roundness": null,
      "seed": 1112693120,
      "version": 673,
      "versionNonce": 88479103,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789750774784,
      "link": null,
      "locked": false,
      "text": "we know that two vertices of it are in a base segment\nand 1 is already predefined; so we'll be constructing\nrelative to that hence \nwe can choose any point on the line and\nany point noncollinear to that point\n\nso going straight to the point break down the triangle\ninto comps and theres the base which needs two endpoints\nthe one we're tryhing to  construct so we could\nreword its comp like\ngiven a sidelenght and a point from which ud construct\na base how many bases can we construct from that\npoint ! 2 ; <- postulate btw;",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we know that two vertices of it are in a base segment\nand 1 is already predefined; so we'll be constructing\nrelative to that hence \nwe can choose any point on the line and\nany point noncollinear to that point\n\nso going straight to the point break down the triangle\ninto comps and theres the base which needs two endpoints\nthe one we're tryhing to  construct so we could\nreword its comp like\ngiven a sidelenght and a point from which ud construct\na base how many bases can we construct from that\npoint ! 2 ; <- postulate btw;",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
