    },
    {
      "id": "Npe5IaTCs90IXlacCCGp9",
      "type": "text",
      "x": 927,
      "y": -451,
      "width": 1476.2515869140625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9T",
      "roundness": null,
      "seed": 541700447,
      "version": 813,
      "versionNonce": 2087244369,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789751593659,
      "created": 1789751273547,
      "link": null,
      "locked": false,
      "text": "the height of Left subtree on the right side is either equal to right subtree\nmore than 1 to the right subtree\nless than 1 to the right subtree.\nhence it is a tree which is able to become a companion of the right\nsubtree of the parent node on the left. \nwe also know that the height of the left subtree on the left is 2 more than\nthe right subtree hence if we push P down to the right subtree it becomes the new\nright subtree and we can balance itself with the orignal right subtree by\nadding the left's right subtree to its left <- because of the invariant property\nof bsts .",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the height of Left subtree on the right side is either equal to right subtree\nmore than 1 to the right subtree\nless than 1 to the right subtree.\nhence it is a tree which is able to become a companion of the right\nsubtree of the parent node on the left. \nwe also know that the height of the left subtree on the left is 2 more than\nthe right subtree hence if we push P down to the right subtree it becomes the new\nright subtree and we can balance itself with the orignal right subtree by\nadding the left's right subtree to its left <- because of the invariant property\nof bsts .",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
